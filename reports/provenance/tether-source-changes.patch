+      if (!embedded && distance(legalPoint(projectile, view.arena, 0.01), projectile) > 0.05) break;
+      if (lineDistance(enemy, previous, projectile).distance <= 0.4) { hit++; break; }
+      previous = projectile;
+    }
+  }
