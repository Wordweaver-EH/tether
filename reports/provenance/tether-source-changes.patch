+}
+
+export function createReflection() {
+  const notes = [];
+  return {
+    considerRecall({ time, spear, own, particles }) {
+      if (spear.state !== 'EMBEDDED' || !particles?.length) return null;
+      const hitChance = particles.filter((p) =>
