+import {classifyEffect} from './audit-stats.mjs';
+const escape=(s)=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
+const number=(x)=>x===null||x===undefined?'unavailable':Number(x).toFixed(3);
+const interval=(e)=>!e||e.mean===null?'unavailable':`${number(e.mean)} [${number(e.lo)}, ${number(e.hi)}]`;
+
+const BEHAVIOR_METRICS=['throwsPerMinute','recallsPerMinute','lookAwayFraction','scanReversalsPerMinute','hitsAfterLookAwayPerMinute','secondLocationFraction','meanMovementInput','aimChangePerTick'];
+export function behaviorVerdict(row){
+ const values=BEHAVIOR_METRICS.map(k=>row.effects[k]).filter(e=>e?.mean!==null&&e?.mean!==undefined&&e.n>=2);
+ if(!values.length)return 'untested / insufficient seeds';
+ if(values.every(e=>e.mean===0&&e.lo===0&&e.hi===0))return 'observed null on tracked behavior';
+ if(values.some(e=>e.lo>0||e.hi<0))return 'external difference (exploratory)';
+ return 'inconclusive / null-compatible';
+}
+
+export function auditMarkdown(report){
+ const lines=['# Tether functional indicator audit','',`Run status: ${report.status}. ${report.rows.length} bouts, ${report.config.durationSec} seconds each; ${report.config.seeds} independent seed clusters.`,
+ `Budgets: ${report.config.budgets.join(', ')} deterministic work units per cycle. Requested budget is identical within every matched pair; charged units are deterministic algorithmic work counts, not wall-clock time or measured CPU instructions. Actual spending can differ.`,
+ '', '## Interpretation',
+ 'All effects are ablated minus full. Negative win/score effects favor the full mind. Behavior effects and internal compute usage are reported separately. Bootstrap 95% intervals resample seed clusters, keeping repeated modes/seats/opponents together. These are descriptive and unadjusted for multiple comparisons; they do not establish subjective experience, general intelligence, or human engagement.',
+ 'Null-compatible intervals are inconclusive; exact zero on measured outputs is an observed null for this protocol, not proof of absence. A mechanism is not validated merely because its internal telemetry changes.',
+ 'Single bouts start with fresh memory. Across-bout competence stages require the separate learning protocol. First/last-third hits-per-throw-count ratios here are descriptive, are not launch-cohort probabilities, and can exceed one when delayed hits cross intervals; they do not identify adaptation. No human-derived proxy data were available. Speech/bluff effects are untested because opponents do not consume speech.',
+ '', '## Paired win and behavior effects',
+ 'Each budget row averages paired seats, modes and opponents within each seed; n is the number of independent seed clusters, not the much larger bout count. A given seed initializes agents equally but ablation can change later PRNG consumption.',
+ '| Ablation | Budget | Δ win [95% CI] | Δ score margin | Δ throws/min | Δ look-away | Δ scan reversals/min |',
+ '|---|---:|---|---|---|---|---|'];
+ for(const r of report.summary)lines.push(`| ${r.variant} | ${r.budget} | ${interval(r.effects.win)} | ${interval(r.effects.scoreMargin)} | ${interval(r.effects.throwsPerMinute)} | ${interval(r.effects.lookAwayFraction)} | ${interval(r.effects.scanReversalsPerMinute)} |`);
+ lines.push('','## External behavior verdicts','These labels use only externally visible action/behavior metrics, not internal counters. Multiple comparisons are unadjusted; differences are exploratory, not a validated consciousness indicator.','| Ablation | Budget | Outcome |','|---|---:|---|');
+ for(const r of report.summary)lines.push(`| ${r.variant} | ${r.budget} | ${behaviorVerdict(r)} |`);
+ lines.push('','## Cognition diagnostics (not external behavioral validation)','| Ablation | Budget | Δ spent/cycle | Δ escalation fraction | Δ automatic fraction | Win interpretation |','|---|---:|---|---|---|---|');
+ for(const r of report.summary)lines.push(`| ${r.variant} | ${r.budget} | ${interval(r.effects.budgetSpentPerCycle)} | ${interval(r.effects.escalationFraction)} | ${interval(r.effects.automaticFraction)} | ${classifyEffect(r.effects.win)} |`);
+ lines.push('','## Opponent-specific score effects','| Ablation | Budget | Opponent | Δ score margin [95% CI] |','|---|---:|---|---|');
+ for(const r of report.summary)for(const [opponent,effects] of Object.entries(r.byOpponent??{}))lines.push(`| ${r.variant} | ${r.budget} | ${opponent} | ${interval(effects.scoreMargin)} |`);
+ lines.push('','## Reproduce',`Command: ${report.command}`,`Source SHA-256: ${report.sourceFingerprint.before}`,`Source unchanged during run: ${report.sourceFingerprint.before===report.sourceFingerprint.after}`,`Node: ${report.runtime.node}; elapsed seconds: ${number(report.runtime.seconds)}; workers: ${report.config.workers}`, '', 'The JSON includes every bout, complete metric effects, mode splits, settings, budget checks, and source file hashes. Results apply only to the recorded source snapshot and opponents.');
+ return lines.join('\n')+'\n';
+}
+export function auditHtml(report){
+ const rows=report.summary.map(r=>`<tr><th>${escape(r.variant)}</th><td>${r.budget}</td><td>${interval(r.effects.win)}</td><td>${interval(r.effects.scoreMargin)}</td><td>${interval(r.effects.throwsPerMinute)}</td><td>${interval(r.effects.lookAwayFraction)}</td><td>${interval(r.effects.scanReversalsPerMinute)}</td><td>${interval(r.effects.budgetSpentPerCycle)}</td></tr>`).join('');
+ return `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tether • Indicator audit</title><style>body{margin:0;background:#0b141c;color:#edf1ed;font:16px/1.6 system-ui,sans-serif}main{max-width:1500px;padding:40px 5vw;margin:auto}h1{font-size:clamp(2rem,5vw,4rem);line-height:1.1}h2{margin-top:2em}p{max-width:100ch}.tag{color:#f4b16c;letter-spacing:.13em;text-transform:uppercase}.cards{display:flex;gap:20px;flex-wrap:wrap}.card{padding:20px;background:#16232d;border-radius:12px;min-width:150px}.card b{display:block;font-size:1.6em}.table{overflow:auto}table{border-collapse:collapse;font-size:13px;width:100%;font-variant-numeric:tabular-nums}th,td{padding:12px;border-bottom:1px solid #33414c;text-align:left}thead{background:#20313e}tbody tr:hover{background:#152834}code{word-break:break-all;color:#9bdace}details{margin:1em 0}pre{white-space:pre-wrap;font-size:13px;background:#16232d;padding:20px;border-radius:12px}.warning{border-left:4px solid #f4b16c;padding:12px 20px;background:#201f1c}</style><main><p class="tag">Tether / Functional mechanisms / CPU-only</p><h1>What changes when a mechanism is removed?</h1><p class="warning">${escape(report.status)}. This audit measures behavior and compute allocation in a toy environment. It is not a test of subjective experience, and it does not establish that the NPC is conscious.</p><div class="cards"><div class="card"><b>${report.rows.length}</b>bouts</div><div class="card"><b>${report.config.durationSec}s</b>per bout</div><div class="card"><b>${report.config.seeds}</b>seed clusters</div><div class="card"><b>${report.config.budgets.join(' / ')}</b>work-unit budgets</div></div><h2>Matched ablations</h2><p>Each ablated mind receives the same per-cycle budget as the full mind. Rows pair the same seed, seat, mode and opponent. Values are ablated minus full, with seed-cluster bootstrap 95% intervals. Negative win or score effects favor the full mind. Internal budget shifts alone do not count as external behavior changes.</p><div class="table"><table><thead><tr><th>Removed mechanism</th><th>Budget</th><th>Δ win</th><th>Δ score</th><th>Δ throws/min</th><th>Δ look-away</th><th>Δ scans/min</th><th>Δ work/cycle</th></tr></thead><tbody>${rows}</tbody></table></div><h2>Nulls, negatives and limits</h2><p>Null-compatible intervals remain inconclusive. These intervals are descriptive, unadjusted for many comparisons, and limited to the selected bots. Human engagement, speech-induced deception and subjective experience are untested. Across-bout competence and within-bout adaptation require the separate learning protocol; aggregate win changes cannot substitute for those curves.</p><details><summary>Full methods and effect tables</summary><pre>${escape(auditMarkdown(report))}</pre></details><h2>Reproduce this snapshot</h2><p><code>${escape(report.command)}</code></p><p>Source SHA-256: <code>${escape(report.sourceFingerprint.before)}</code></p><p>Source stable during run: ${report.sourceFingerprint.before===report.sourceFingerprint.after}. Node ${escape(report.runtime.node)}. Runtime ${number(report.runtime.seconds)} seconds.</p></main></html>`;
+}
