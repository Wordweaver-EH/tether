+      const p = (min - a[axis]) / d, q = (max - a[axis]) / d;
+      lo = Math.max(lo, Math.min(p, q)); hi = Math.min(hi, Math.max(p, q));
+      if (lo > hi) return false;
+    }
+  }
+  return hi >= 0 && lo <= 1;
+}
+
+export function planMove(origin, rawTarget, arena) {
+  if (!rawTarget) return point(0, 0);
