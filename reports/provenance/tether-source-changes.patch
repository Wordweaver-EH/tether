+    const d = b[axis] - a[axis];
+    const min = box[axis === 'x' ? 'minX' : 'minY'] - margin;
+    const max = box[axis === 'x' ? 'maxX' : 'maxY'] + margin;
+    if (Math.abs(d) < 1e-9) { if (a[axis] < min || a[axis] > max) return false; }
