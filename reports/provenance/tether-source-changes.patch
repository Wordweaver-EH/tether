+import { rng, point, add, clamp, dot, unit, sub } from './math.mjs';
+import { createOwnSpearMemory } from './own-spear.mjs';
+
+export const ABLATION_FLAGS = ['noBelief', 'noPrediction', 'singleUtility', 'noWorkspace',
